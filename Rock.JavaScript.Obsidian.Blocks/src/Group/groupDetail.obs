<template>
    <div ref="blockTopElement"></div>
    <NotificationBox v-if="blockError" alertType="warning" v-html="blockError"></NotificationBox>

    <NotificationBox v-if="errorMessage" ref="errorMessageElement" alertType="danger" v-html="errorMessage"></NotificationBox>

    <DetailBlock v-if="!blockError"
                 v-model:mode="panelMode"
                 :name="panelName"
                 :titleIconCssClass="panelTitleIconCssClass"
                 :labels="blockLabels"
                 :headerLabels="headerLabels"
                 :entityKey="entityKey"
                 :isAuditHidden="isAuditHidden"
                 :isBadgesVisible="panelMode !== DetailPanelMode.Add"
                 :isDeleteVisible="isDeleteVisible"
                 :isEditVisible="canEdit"
                 :isFollowVisible="isFollowVisible"
                 :isSecurityHidden="panelMode === DetailPanelMode.Add"
                 :isTagsVisible="isTagListShown"
                 :showExperienceMode="true"
                 :footerActions="footerActions"
                 :footerSecondaryActions="footerSecondaryActions"
                 @cancelEdit="onCancelEdit"
                 @delete="onDelete"
                 @edit="onEdit"
                 @save="onSave">
        <template #view>
            <ViewPanel :modelValue="groupViewBag"
                       :options="options"
                       :navigationUrls="config.navigationUrls" />
        </template>

        <template #edit>
            <EditPanel v-model="groupEditBag"
                       :groupTypeOptions="groupTypeOptions"
                       :allowedGroupTypes="allowedGroupTypes"
                       :signatureDocumentTemplates="signatureDocumentTemplates"
                       :preventSelectingInactiveCampus="preventSelectingInactiveCampus"
                       :errorMessage="errorMessage"
                       @propertyChanged="baseBlock.onPropertyChanged" />
        </template>
    </DetailBlock>

    <CopyModal v-model="isCopyModalVisible"
               @save="onCopySave" />

    <Modal v-model="isArchiveChildPromptVisible"
           title="Archive Child Groups?"
           saveText="Yes"
           cancelText="No"
           @save="onArchiveCascade"
           @closeModal="onArchiveSingle">
        <p>Would you like to archive this group's children?</p>
    </Modal>
</template>

<script setup lang="ts">
    import { computed, nextTick, ref, watch } from "vue";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Modal from "@Obsidian/Controls/modal.obs";
    import { confirm, confirmDelete } from "@Obsidian/Utility/dialogs";
    import { addQuickReturn } from "@Obsidian/Utility/page";
    import DetailBlock from "@Obsidian/Templates/detailBlock";
    import { DetailPanelMode } from "@Obsidian/Enums/Controls/detailPanelMode";
    import { PanelAction } from "@Obsidian/Types/Controls/panelAction";
    import { onConfigurationValuesChanged, useConfigurationValues, useEntityDetailBlock, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { DetailBlockBox } from "@Obsidian/ViewModels/Blocks/detailBlockBox";
    import { RelationshipStrengthDescription } from "@Obsidian/Enums/Group/relationshipStrength";
    import { GroupBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupBag";
    import { GroupDetailOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupDetailOptionsBag";
    import { GroupTypeOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupTypeOptionsBag";
    import { CopyGroupRequestBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/copyGroupRequestBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import ViewPanel from "./GroupDetail/viewPanel.partial.obs";
    import EditPanel from "./GroupDetail/editPanel.partial.obs";
    import CopyModal from "./GroupDetail/copyModal.partial.obs";
    import { BlockActionName, NavigationUrlKey } from "./GroupDetail/types.partial";

    const config = useConfigurationValues<DetailBlockBox<GroupBag, GroupDetailOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();

    onConfigurationValuesChanged(useReloadBlock());

    // #region Values

    const blockError = ref("");
    const errorMessage = ref("");
    const errorMessageElement = ref<InstanceType<typeof NotificationBox> | null>(null);
    const blockTopElement = ref<HTMLElement | null>(null);

    const groupViewBag = ref(config.entity);
    const groupEditBag = ref<ValidPropertiesBox<GroupBag>>({
        bag: {} as GroupBag
    });

    const groupTypeOptions = ref<GroupTypeOptionsBag>({} as GroupTypeOptionsBag);
    const allowedGroupTypes = computed((): ListItemBag[] => config.options?.allowedGroupTypes ?? []);
    const signatureDocumentTemplates = computed((): ListItemBag[] => config.options?.signatureDocumentTemplates ?? []);
    const preventSelectingInactiveCampus = computed((): boolean => config.options?.preventSelectingInactiveCampus ?? false);

    const panelMode = ref<DetailPanelMode>(DetailPanelMode.View);

    const baseBlock = useEntityDetailBlock({
        blockConfig: config,
        entity: groupEditBag
    });

    const isCopyModalVisible = ref(false);
    const isArchiveChildPromptVisible = ref(false);
    const archiveResolution = ref<((value: BlockActionName.Archive | BlockActionName.ArchiveWithChildren | false) => void) | null>(null);

    // #endregion

    // #region Computed Values

    const panelName = computed((): string => {
        return panelMode.value === DetailPanelMode.Add ? "Add Group" : groupViewBag.value?.name ?? "";
    });

    const panelTitleIconCssClass = computed((): string => {
        return panelMode.value === DetailPanelMode.Add ? "" : groupViewBag.value?.iconCssClass ?? "";
    });

    const entityKey = computed((): string => groupViewBag.value?.idKey ?? "");

    const options = computed((): GroupDetailOptionsBag => config.options ?? {} as GroupDetailOptionsBag);

    const canEdit = computed((): boolean => groupViewBag.value?.canEdit === true);

    const isDeleteVisible = computed((): boolean => panelMode.value !== DetailPanelMode.Add && options.value.isDeleteVisible === true);

    const isTagListShown = computed((): boolean => panelMode.value !== DetailPanelMode.Add && options.value.isTagListShown === true);

    const isAuditHidden = computed((): boolean => panelMode.value === DetailPanelMode.Add);

    const isFollowVisible = computed((): boolean => panelMode.value !== DetailPanelMode.Add);

    /**
     * Labels rendered in the panel sub-header. Phase 1 surfaces the
     * lifecycle / context labels (Archived, Inactive, Relationship
     * Strength, Public). The GroupType and Campus chips are split off
     * into headerLabels so they render next to the panel title per
     * the figma. Hidden in Add mode.
     */
    const blockLabels = computed((): PanelAction[] => {
        const bag = groupViewBag.value;
        if (!bag || panelMode.value !== DetailPanelMode.View) {
            return [];
        }

        const labels: PanelAction[] = [];

        if (bag.isArchived) {
            labels.push({ title: "Archived", type: "warning" });
        }

        if (!bag.isActive) {
            labels.push({ title: "Inactive", type: "warning" });
        }

        if (bag.relationshipStrength != null) {
            const strengthLabel = RelationshipStrengthDescription[bag.relationshipStrength];
            if (strengthLabel) {
                labels.push({ title: strengthLabel, type: "default" });
            }
        }

        if (bag.isPublic) {
            labels.push({ title: "Public", type: "info" });
        }

        if (bag.isChatEnabled) {
            labels.push({
                title: "Chat-Enabled",
                type: "info",
                iconCssClass: "ti ti-messages"
            });
        }

        return labels;
    });

    /**
     * Labels rendered next to the panel title (header). GroupType is
     * tinted by GroupType.GroupTypeColor when set; Campus uses Rock's
     * .label-campus outlined style. Hidden in Add mode.
     */
    const headerLabels = computed((): PanelAction[] => {
        const bag = groupViewBag.value;
        if (!bag || panelMode.value !== DetailPanelMode.View) {
            return [];
        }

        const labels: PanelAction[] = [];

        if (bag.groupType?.name) {
            const groupTypeUrl = bag.groupType.url;
            const groupTypeColor = bag.groupType.color;
            labels.push({
                title: bag.groupType.name,
                type: "campus",
                style: groupTypeColor
                    ? `color: ${groupTypeColor}; border-color: ${groupTypeColor};`
                    : undefined,
                handler: groupTypeUrl
                    ? () => {
                        window.location.href = groupTypeUrl;
                    }
                    : undefined
            });
        }

        if (bag.campusName) {
            labels.push({ title: bag.campusName, type: "campus" });
        }

        return labels;
    });

    /**
     * Footer secondary actions (right side of the panel footer). The
     * Copy button shows when ShowCopyButton is enabled and the user has
     * EDIT auth. Security and Edit are framework-managed.
     */
    const footerSecondaryActions = computed((): PanelAction[] => {
        const actions: PanelAction[] = [];

        if (panelMode.value === DetailPanelMode.View && options.value.isCopyButtonShown) {
            actions.push({
                iconCssClass: "ti ti-copy",
                title: "Copy Group",
                type: "default",
                handler: openCopyModal
            });
        }

        return actions;
    });

    /**
     * Footer primary actions (left side of the panel footer). Phase 1
     * surfaces Archive in view mode when ShouldShowArchiveInsteadOfDelete
     * is true; the Vue layer would otherwise rely on the framework's
     * Delete button which is hidden by IsDeleteHidden in that case.
     */
    const footerActions = computed((): PanelAction[] => {
        const actions: PanelAction[] = [];

        if (panelMode.value === DetailPanelMode.View && options.value.isArchiveVisible) {
            actions.push({
                title: "Archive",
                type: "link",
                handler: onArchiveClick
            });
        }

        return actions;
    });

    // #endregion

    // #region Functions

    /**
     * Shows the Copy Group modal so the user can pick a copy target.
     */
    function openCopyModal(): void {
        isCopyModalVisible.value = true;
    }

    /**
     * Opens the archive-children prompt and awaits the user's choice.
     */
    function showArchiveChildPrompt(): Promise<BlockActionName.Archive | BlockActionName.ArchiveWithChildren | false> {
        return new Promise(resolve => {
            archiveResolution.value = resolve;
            isArchiveChildPromptVisible.value = true;
        });
    }

    /**
     * Reactively fetches GroupTypeOptionsBag whenever the edit bag's
     * groupTypeId changes (Q2 Approach B). Covers initial Edit (onEdit
     * assigns the bag), Add-mode group-type pick (EditPanel updates the
     * bag via v-model), and mid-edit group-type swap.
     */
    watch(() => groupEditBag.value.bag?.groupTypeId, async (newId) => {
        if (!newId || newId <= 0) {
            groupTypeOptions.value = {} as GroupTypeOptionsBag;
            return;
        }

        const result = await invokeBlockAction<GroupTypeOptionsBag>("GetGroupTypeOptions", { groupTypeId: newId });
        if (result.isSuccess && result.data) {
            groupTypeOptions.value = result.data;
        }
        else {
            errorMessage.value = result.errorMessage ?? "Unable to fetch options for this Group Type.";
            scrollToErrorNotification();
        }
    });

    watch(panelMode, (newMode) => {
        if (newMode === DetailPanelMode.Edit) {
            nextTick(() => {
                blockTopElement.value?.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
            });
        }
    });

    /**
    * Smoothly scrolls the error NotificationBox into view after the DOM
    * has had a chance to render it. Used by every server-error path so
    * the user sees the message even if they were scrolled mid-form.
    */
    function scrollToErrorNotification(): void {
        nextTick(() => {
            if (errorMessageElement.value?.$el) {
                errorMessageElement.value.$el.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest",
                });
            }
        });
    }

    // #endregion

    // #region Event Handlers

    /**
     * Cancel from edit mode. ?returnUrl= takes precedence (WebForms parity
     * at GroupDetail.ascx.cs:1460-1463 — unconditional, no autoEdit gate;
     * the framework's onCancelEdit handler at detailBlock.ts:630-638 only
     * honors returnUrl when ?autoEdit=true is also set, so the block has
     * to echo it for non-autoEdit Cancel flows). Otherwise: existing
     * group → return to view mode; Add mode → redirect to GroupListPage
     * if configured, else stay put.
     */
    async function onCancelEdit(): Promise<boolean | string> {
        const returnUrl = new URLSearchParams(window.location.search).get("returnUrl");
        if (returnUrl) {
            return returnUrl;
        }

        if (!groupEditBag.value.bag?.idKey) {
            if (config.navigationUrls?.[NavigationUrlKey.GroupListPage]) {
                return config.navigationUrls[NavigationUrlKey.GroupListPage];
            }

            return false;
        }

        return true;
    }

    /**
     * Edit click. Calls the C# Edit block action and assigns the bag.
     * The watcher on groupEditBag.bag.groupTypeId then reactively
     * fetches GroupTypeOptionsBag.
     */
    async function onEdit(): Promise<boolean> {
        const result = await invokeBlockAction<ValidPropertiesBox<GroupBag>>(BlockActionName.Edit, {
            key: groupViewBag.value?.idKey
        });

        if (result.isSuccess && result.data && result.data.bag) {
            groupEditBag.value = {
                bag: result.data.bag,
                validProperties: result.data.validProperties ?? Object.keys(result.data.bag)
            };

            return true;
        }

        errorMessage.value = result.errorMessage ?? "Unable to enter edit mode.";
        scrollToErrorNotification();
        return false;
    }

    /**
     * Save click. Calls the C# Save block action. On 200 (Update) the
     * response is a refreshed ValidPropertiesBox<GroupBag>; we copy its
     * bag into groupViewBag so the View panel reflects new values. On
     * 201 (Create) the response is a redirect URL string; we navigate.
     */
    async function onSave(): Promise<boolean | string> {
        errorMessage.value = "";

        const result = await invokeBlockAction<ValidPropertiesBox<GroupBag> | string>(BlockActionName.Save, {
            box: groupEditBag.value
        });

        if (result.isSuccess && result.data) {
            if (result.statusCode === 200 && typeof result.data === "object") {
                groupViewBag.value = result.data.bag;
                return true;
            }
            else if (result.statusCode === 201 && typeof result.data === "string") {
                return result.data;
            }
        }

        errorMessage.value = result.errorMessage ?? "Unknown error while trying to save group.";
        scrollToErrorNotification();
        return false;
    }

    /**
     * Delete click. Confirms with the user, then calls the Delete block
     * action and follows the redirect URL it returns.
     */
    async function onDelete(): Promise<false | string> {
        errorMessage.value = "";

        const confirmed = await confirmDelete("Group");
        if (!confirmed) {
            return false;
        }

        const result = await invokeBlockAction<string>(BlockActionName.Delete, {
            key: groupViewBag.value?.idKey
        });

        if (result.isSuccess && result.data) {
            return result.data;
        }

        errorMessage.value = result.errorMessage ?? "Unable to delete the group.";
        scrollToErrorNotification();
        return false;
    }

    /**
     * Archive click. Confirms, then if the bag indicates child groups
     * exist, opens the child-archive prompt and routes to either
     * Archive (No) or ArchiveWithChildren (Yes). When no children
     * exist, calls Archive directly.
     */
    async function onArchiveClick(): Promise<void> {
        errorMessage.value = "";

        const confirmed = await confirm("Are you sure you want to archive this group?");
        if (!confirmed) {
            return;
        }

        const cascadeAction = groupViewBag.value?.hasChildGroups
            ? await showArchiveChildPrompt()
            : BlockActionName.Archive;

        if (!cascadeAction) {
            return;
        }

        const result = await invokeBlockAction<string>(cascadeAction, {
            key: groupViewBag.value?.idKey
        });

        if (result.isSuccess && result.data) {
            window.location.href = result.data;
            return;
        }

        errorMessage.value = result.errorMessage ?? "Unable to archive the group.";
        scrollToErrorNotification();
    }

    /** "Yes" from the archive-children prompt: cascade to descendants. */
    function onArchiveCascade(): void {
        isArchiveChildPromptVisible.value = false;

        if (archiveResolution.value) {
            archiveResolution.value(BlockActionName.ArchiveWithChildren);
            archiveResolution.value = null;
        }
    }

    /** "No" from the archive-children prompt: archive the parent only. */
    function onArchiveSingle(): void {
        isArchiveChildPromptVisible.value = false;

        if (archiveResolution.value) {
            archiveResolution.value(BlockActionName.Archive);
            archiveResolution.value = null;
        }
    }

    /**
     * Save from the Copy modal. Calls Copy and follows the redirect
     * URL it returns (always points at the new group; Copy does NOT
     * honor returnUrl).
     */
    async function onCopySave(bag: CopyGroupRequestBag): Promise<void> {
        errorMessage.value = "";

        const result = await invokeBlockAction<string>(BlockActionName.Copy, {
            bag: {
                ...bag,
                key: groupViewBag.value?.idKey
            } satisfies CopyGroupRequestBag
        });

        isCopyModalVisible.value = false;

        if (result.isSuccess && result.data) {
            window.location.href = result.data;
            return;
        }

        errorMessage.value = result.errorMessage ?? "Unable to copy the group.";
        scrollToErrorNotification();
    }

    // #endregion

    // Handle any initial error conditions or the need to enter Add mode.
    if (config.errorMessage) {
        blockError.value = config.errorMessage;
    }
    else if (!config.entity) {
        blockError.value = "The specified group could not be viewed.";
    }
    else if (!config.entity.idKey) {
        groupEditBag.value = { bag: config.entity };
        panelMode.value = DetailPanelMode.Add;
    }

    // Register the group in the user's "Groups" Quick Return menu when
    // viewing an existing group. Skip in Add mode (no entity yet).
    if (panelMode.value === DetailPanelMode.View && groupViewBag.value?.name && groupViewBag.value?.idKey) {
        addQuickReturn(groupViewBag.value.name, "Groups", 20);
    }
</script>
