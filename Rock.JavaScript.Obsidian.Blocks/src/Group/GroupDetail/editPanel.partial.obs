<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <ContentSectionContainer :sidebar="false">
        <NotificationBox v-if="isSystem" alertType="info">
            <strong>Note</strong> Because this group is used by Rock, editing is restricted.
        </NotificationBox>

        <!-- ========================== -->
        <!-- Section 1 - Top fields -->
        <!-- ========================== -->
        <ContentSection light>
            <div class="basic-fields">
                <div class="row">
                    <div class="col-md-6">
                        <TextBox v-model="name" label="Name" rules="required" :maxLength="100" />
                    </div>

                    <div class="col-md-6">
                        <CheckBox v-model="isActive" label="Active" />
                    </div>
                </div>

                <ConditionalWell v-if="!isActive">
                    <DropDownList v-if="groupTypeOptions.isInactiveReasonVisible"
                                  v-model="inactiveReasonValueIdValue"
                                  label="Inactive Reason"
                                  help="The reason this group is inactive."
                                  :items="inactiveReasonItems"
                                  :rules="groupTypeOptions.isInactiveReasonRequired ? 'required' : ''" />

                    <TextBox v-model="inactiveReasonNote"
                             label="Inactive Note"
                             textMode="multiline"
                             help="Additional context about why this group is inactive."
                             :rows="3" />

                    <div class="form-group">
                        <InlineCheckBox v-if="hasChildGroups"
                                        v-model="inactivateChildGroups"
                                        label="Also Inactivate Child Groups"
                                        help="When checked, all active descendants are marked inactive on save." />
                    </div>
                </ConditionalWell>

                <TextBox v-model="description"
                         label="Description"
                         textMode="multiline"
                         :rows="4" />

                <div class="form-group">
                    <InlineCheckBox v-model="isPublic" label="Show Publicly" />
                </div>

                <ImageUploader v-model="photoBinaryFile"
                               label="Image"
                               :binaryFileTypeGuid="binaryFileTypeDefault" />
            </div>
        </ContentSection>

        <!-- ========================== -->
        <!-- Section 2 - General -->
        <!-- ========================== -->
        <ContentSection title="General" icon="ti ti-settings">
            <!-- Stack 1 - Overview -->
            <ContentStack title="Overview" description="Basic information that identifies this group and places it within the organization.">
                <div class="row">
                    <div class="col-md-6">
                        <template v-if="isAddMode">
                            <DropDownList v-model="groupTypeIdValue"
                                          label="Group Type"
                                          :items="allowedGroupTypeItems"
                                          rules="required"
                                          :showBlankItem="true" />

                            <NotificationBox v-if="!isCurrentGroupTypeAllowed" ref="groupTypeWarningElement" alertType="warning">
                                The selected parent group does not allow this Group Type. Choose a different Group Type or parent group.
                            </NotificationBox>
                        </template>

                        <div v-else class="static-compact">
                            <StaticFormControl label="Group Type"
                                               :modelValue="modelValue.bag?.groupType?.name ?? ''" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <GroupPicker v-model="parentGroup"
                                     label="Parent Group" />

                        <NotificationBox v-if="parentGroup && !parentGroupIsActive" alertType="warning">
                            The selected parent group is inactive. Children of inactive groups may be hidden by default in some areas of Rock.
                        </NotificationBox>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <CampusPicker v-model="campus"
                                      label="Campus"
                                      :includeInactive="!preventSelectingInactiveCampus"
                                      :rules="groupTypeOptions.requiresCampus ? 'required' : ''" />
                    </div>
                </div>

                <div v-if="groupTypeOptions.isStatusVisible" class="row">
                    <div class="col-md-6">
                        <DropDownList v-model="statusValueIdValue"
                                      label="Status"
                                      :items="statusItems" />
                    </div>
                </div>
            </ContentStack>

            <!-- Stack 2 - Administration & Security -->
            <ContentStack title="Administration &amp; Security" description="Administrative, capacity, and security settings that control how this group is managed.">
                <div v-if="groupTypeOptions.isAdministratorVisible" class="row">
                    <div class="col-md-6">
                        <PersonPicker v-model="groupAdministrator"
                                      :label="groupTypeOptions.administratorTerm || 'Group Administrator'"
                                      :trailblazerField="true" />
                    </div>
                </div>

                <div v-if="groupTypeOptions.isGroupCapacityVisible" class="row">
                    <div class="col-md-6">
                        <NumberBox v-model="groupCapacity"
                                   label="Group Capacity"
                                   help="Maximum number of members for this group."
                                   :rules="groupTypeOptions.isGroupCapacityRequired ? 'required' : ''"
                                   :minimumValue="0"
                                   :decimalCount="0">
                            <template #inputGroupAppend>
                                <span class="input-group-addon">Members</span>
                            </template>
                        </NumberBox>

                        <NotificationBox v-if="isCapacityBelowMemberCount" alertType="warning">
                            This group has {{ bag.memberCount }} active member{{ bag.memberCount === 1 ? "" : "s" }}, which exceeds the capacity of {{ groupCapacity }}.
                        </NotificationBox>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <DropDownList v-model="requiredSignatureDocumentTemplateIdValue"
                                      label="Required Signature Document"
                                      :items="signatureDocumentTemplateItems"
                                      :showBlankItem="true"
                                      :trailblazerField="true" />
                    </div>
                </div>

                <div v-if="groupTypeOptions.isGroupSpecificRecordSourceVisible" class="row">
                    <div class="col-md-6">
                        <DefinedValuePicker v-model="recordSourceValue"
                                            label="Member Record Source"
                                            help="The default record source assigned to new members of this group."
                                            :definedTypeGuid="recordSourceDefinedTypeGuid"
                                            :showBlankItem="true"
                                            :trailblazerField="true" />
                    </div>
                </div>

                <div v-if="isCurrentPersonGroupAdministrator" class="form-group">
                    <InlineCheckBox v-model="isSecurityRole"
                                    label="Enable as Security Role"
                                    :disabled="isLimitedToSecurityRoleGroups" />
                </div>

                <div v-if="isSecurityRole" class="row">
                    <div class="col-md-6">
                        <ConditionalWell>
                            <RadioButtonList v-model="elevatedSecurityLevelValue"
                                             label="Security Level"
                                             :items="elevatedSecurityLevelItems" />
                        </ConditionalWell>
                    </div>
                </div>
            </ContentStack>

            <!-- Stack 3 - Relationships -->
            <ContentStack v-if="groupTypeOptions.isPeerNetworkSectionVisible"
                          title="Relationships" description="Relationship settings that define how connection strength is calculated for this group.">
                <div class="form-group">
                    <InlineCheckBox v-model="overrideRelationshipStrength"
                                    label="Override Relationship Strength" />
                </div>

                <template v-if="overrideRelationshipStrength">
                    <RadioButtonList v-model="relationshipStrengthOverrideValue"
                                     label="Relationship Strength"
                                     :items="relationshipStrengthItems" />

                    <div class="form-group">
                        <InlineSwitch v-if="hasRelationshipStrengthOverride"
                                      v-model="showAdvancedRelationshipSettings"
                                      label="Show Advanced Relationship Settings"
                                      :trailblazerField="true" />
                    </div>

                    <ConditionalWell v-if="showAdvancedRelationshipSettings && hasRelationshipStrengthOverride">
                        <div class="form-group">
                            <InlineCheckBox v-model="relationshipGrowthEnabledOverride"
                                            label="Enable Relationship Growth Over Time"
                                            help="Allow the strength of this group's relationships to increase over time." />
                        </div>

                        <NotificationBox alertType="info">
                            Use the matrix to adjust relationship scores based on group member relationships. For example, if members have strong connections with group leaders but little interaction with other non-leaders, you can reduce or remove the score percentage between non-leaders.
                        </NotificationBox>

                        <div class="d-grid gap-3 relationship-matrix" style="width: max-content; grid-template-columns: auto auto auto; row-gap: 0.25rem;">
                            <!-- Header Row -->
                            <div></div>
                            <div class="d-flex align-items-center">
                                <RockLabel>Leader</RockLabel>
                            </div>
                            <div class="d-flex align-items-center">
                                <RockLabel>Non-Leader</RockLabel>
                            </div>
                            <!-- Leader Row -->
                            <div class="d-flex align-items-center">
                                <RockLabel>Leader</RockLabel>
                            </div>
                            <div class="d-flex align-items-center">
                                <NumberBox v-model="leaderToLeaderRelationshipMultiplierOverrideValue"
                                           :placeholder="formatPercent(groupTypeOptions.leaderToLeaderMultiplierDefault)"
                                           :decimalCount="0"
                                           :minimumValue="0"
                                           :maximumValue="100"
                                           :maxLength="3"
                                           style="width: 150px;"
                                           validationTitle="Leader to Leader Relationship Multiplier"
                                           :trailblazerField="true">
                                    <template #inputGroupAppend>
                                        <span class="input-group-addon">%</span>
                                    </template>
                                </NumberBox>
                            </div>
                            <div class="d-flex align-items-center">
                                <NumberBox v-model="leaderToNonLeaderRelationshipMultiplierOverrideValue"
                                           :placeholder="formatPercent(groupTypeOptions.leaderToNonLeaderMultiplierDefault)"
                                           :decimalCount="0"
                                           :minimumValue="0"
                                           :maximumValue="100"
                                           :maxLength="3"
                                           style="width: 150px;"
                                           validationTitle="Leader to Non-Leader Relationship Multiplier"
                                           :trailblazerField="true">
                                    <template #inputGroupAppend>
                                        <span class="input-group-addon">%</span>
                                    </template>
                                </NumberBox>
                            </div>
                            <!-- Non-Leader Row -->
                            <div class="d-flex align-items-center">
                                <RockLabel>Non-Leader</RockLabel>
                            </div>
                            <div class="d-flex align-items-center">
                                <NumberBox v-model="nonLeaderToLeaderRelationshipMultiplierOverrideValue"
                                           :placeholder="formatPercent(groupTypeOptions.nonLeaderToLeaderMultiplierDefault)"
                                           :decimalCount="0"
                                           :minimumValue="0"
                                           :maximumValue="100"
                                           :maxLength="3"
                                           style="width: 150px;"
                                           validationTitle="Non-Leader to Leader Relationship Multiplier"
                                           :trailblazerField="true">
                                    <template #inputGroupAppend>
                                        <span class="input-group-addon">%</span>
                                    </template>
                                </NumberBox>
                            </div>
                            <div class="d-flex align-items-center">
                                <NumberBox v-model="nonLeaderToNonLeaderRelationshipMultiplierOverrideValue"
                                           :placeholder="formatPercent(groupTypeOptions.nonLeaderToNonLeaderMultiplierDefault)"
                                           :decimalCount="0"
                                           :minimumValue="0"
                                           :maximumValue="100"
                                           :maxLength="3"
                                           style="width: 150px;"
                                           validationTitle="Non-Leader to Non-Leader Relationship Multiplier"
                                           :trailblazerField="true">
                                    <template #inputGroupAppend>
                                        <span class="input-group-addon">%</span>
                                    </template>
                                </NumberBox>
                            </div>
                        </div>
                    </ConditionalWell>
                </template>
            </ContentStack>
        </ContentSection>

        <!-- ========================== -->
        <!-- Section 3 - RSVP -->
        <!-- ========================== -->
        <ContentSection v-if="groupTypeOptions.isRsvpSectionVisible"
                        title="RSVP"
                        icon="ti ti-ticket">
            <ContentStack title="Reminder Settings" description="Settings that control RSVP reminders for this group.">
                <div class="row">
                    <div class="col-md-6">
                        <StaticFormControl v-if="groupTypeOptions.rsvpReminderSystemCommunication"
                                           label="RSVP Reminder Communication"
                                           help="The System Communication that should be sent to remind group members to RSVP for group events."
                                           :modelValue="groupTypeOptions.rsvpReminderSystemCommunication.text ?? ''" />
                        <DropDownList v-else
                                      v-model="rsvpReminderSystemCommunicationGuid"
                                      label="RSVP Reminder Communication"
                                      help="The System Communication that should be sent to remind group members to RSVP for group events."
                                      :items="groupTypeOptions.rsvpSystemCommunicationOptions ?? []"
                                      showBlankItem
                                      enhanceForLongLists />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <NumberBox v-model="rsvpReminderOffsetDays"
                                   label="RSVP Reminder Lead Time"
                                   help="How many days before an event to send the reminder."
                                   :disabled="groupTypeOptions.rsvpReminderOffsetDays != null"
                                   :minimumValue="0"
                                   :decimalCount="0">
                            <template #inputGroupAppend>
                                <span class="input-group-addon">Days</span>
                            </template>
                        </NumberBox>
                    </div>
                </div>
            </ContentStack>
        </ContentSection>

        <!-- ========================== -->
        <!-- Section 4 - Scheduling -->
        <!-- ========================== -->
        <ContentSection v-if="groupTypeOptions.isSchedulingSectionVisible || groupTypeOptions.isSchedulingEnabled"
                        title="Meeting &amp; Scheduling Details" icon="ti ti-calendar-month">

            <!-- Stack 1 - Overall Group Schedule -->
            <ContentStack v-if="groupTypeOptions.isSchedulingSectionVisible"
                          title="Overall Group Schedule"
                          description="Provide the schedule used to represent when this group meets as a whole.">
                <RadioButtonList v-model="scheduleTypeValue"
                                 label="Group Schedule"
                                 :items="scheduleTypeItems" />

                <ConditionalWell v-if="scheduleType !== scheduleTypeNone">
                    <div v-if="scheduleType === scheduleTypeWeekly" class="row">
                        <div class="col-md-6">
                            <DayOfWeekPicker v-model="weeklyDayOfWeekValue" label="Day of Week" rules="required" />
                        </div>
                        <div class="col-md-6">
                            <TimePicker v-model="weeklyTimeOfDayValue" label="Time of Day" rules="required" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <ScheduleBuilder v-if="scheduleType === scheduleTypeCustom"
                                             v-model="iCalendarContent"
                                             label="Custom Schedule"
                                             rules="required" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <SchedulePicker v-if="scheduleType === scheduleTypeNamed"
                                            v-model="namedSchedule"
                                            label="Named Schedule"
                                            rules="required" />
                        </div>
                    </div>
                </ConditionalWell>
            </ContentStack>

            <!-- Stack 2 - Locations editing (Phase 6) -->
            <LocationsPanel v-model:groupLocations="groupLocations"
                            :familyMemberLocationOptions="familyMemberLocationOptions"
                            :locationSelectionMode="groupTypeOptions.locationSelectionMode"
                            :locationTypeOptions="groupTypeOptions.locationTypeValueOptions ?? []"
                            :enableLocationSchedules="groupTypeOptions.enableLocationSchedules"
                            :isSchedulingEnabled="groupTypeOptions.isSchedulingEnabled"
                            :allowMultipleLocations="groupTypeOptions.allowMultipleLocations"
                            :mapStyleValueGuid="groupTypeOptions.mapStyleValueGuid" />

            <!-- Stack 3 - Member Scheduling & Check-in -->
            <ContentStack v-if="groupTypeOptions.isSchedulingEnabled || groupTypeOptions.isCheckInRequirementsVisible"
                          title="Member Scheduling &amp; Check-in"
                          description="Scheduling behavior and check-in access for this group.">
                <div class="form-group">
                    <InlineCheckBox v-model="disableScheduling"
                                    label="Disable Group Member Scheduling" />
                </div>

                <div class="form-group">
                    <InlineCheckBox v-model="disableScheduleToolboxAccess"
                                    label="Hide from Schedule Toolbox" />
                </div>

                <div class="form-group">
                    <InlineCheckBox v-model="schedulingMustMeetRequirements"
                                    label="Require Member Requirements for Scheduling" />
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <DropDownList v-if="groupTypeOptions.isScheduleConfirmationLogicVisible"
                                      v-model="scheduleConfirmationLogicValue"
                                      label="Confirmation Behavior"
                                      :items="scheduleConfirmationLogicItems"
                                      :showBlankItem="true" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <PersonPicker v-if="groupTypeOptions.isScheduleCoordinatorVisible"
                                      v-model="scheduleCoordinatorPerson"
                                      label="Schedule Coordinator" />
                    </div>
                </div>

                <template v-if="groupTypeOptions.isCoordinatorNotificationsVisible">
                    <div class="form-group">
                        <InlineCheckBox v-model="hasCoordinatorNotificationOverride"
                                        label="Override Coordinator Notifications"
                                        help="Override the group type's default. When unchecked, this group inherits the group type's notification settings." />
                    </div>

                    <ConditionalWell v-if="hasCoordinatorNotificationOverride">
                        <CheckBoxList v-model="scheduleCoordinatorNotificationTypesValue"
                                      label="Coordinator Notifications"
                                      help="Select which notifications the coordinator receives. Leave all unchecked to send no notifications for this group."
                                      :items="coordinatorNotificationItems" />
                    </ConditionalWell>
                </template>

                <RadioButtonList v-if="groupTypeOptions.isCheckInRequirementsVisible"
                                 v-model="attendanceRecordRequiredForCheckInValue"
                                 label="Who Can Check-in"
                                 :items="attendanceRecordRequiredForCheckInItems" />
            </ContentStack>
        </ContentSection>

        <!-- ========================== -->
        <!-- Section 5 - Group Attribute Values -->
        <!-- ========================== -->
        <AttributeValuesContainer v-model="attributeValues"
                                  :attributes="attributes"
                                  :isEditMode="true"
                                  :displayAsContentSection="true"
                                  contentSectionTitle="Group Attributes"
                                  globalCategoryNameOverride="Set Additional Attributes" />

        <!-- ========================== -->
        <!-- Section 6 - Group Member Attribute Definitions -->
        <!-- ========================== -->
        <ContentSection v-if="canAdministrate && (groupTypeOptions.allowSpecificGroupMemberAttributes || inheritedMemberAttributes.length > 0 || groupMemberAttributes.length > 0)"
                        title="Member Attributes"
                        icon="ti ti-user-cog">
            <GroupMemberAttributes v-model:groupMemberAttributes="groupMemberAttributes"
                                   :inheritedGroupMemberAttributes="inheritedMemberAttributes" />
        </ContentSection>

        <!-- ========================== -->
        <!-- Section 7 - Group Requirements -->
        <!-- ========================== -->
        <GroupRequirements v-model:groupRequirements="groupRequirements"
                           :inheritedGroupRequirements="groupTypeOptions.inheritedGroupRequirements ?? []"
                           :groupRequirementTypeOptions="groupTypeOptions.groupRequirementTypeOptions ?? []"
                           :groupRoleOptions="groupTypeOptions.groupRoleOptions ?? []"
                           :groupAttributeOptions="groupTypeOptions.groupAttributeOptions ?? []"
                           :enableSpecificGroupRequirements="groupTypeOptions.enableSpecificGroupRequirements" />

        <!-- ========================== -->
        <!-- Section 8 - Chat -->
        <!-- ========================== -->
        <ContentSection v-if="groupTypeOptions.isChatSectionVisible"
                        title="Chat"
                        icon="ti ti-message-dots">
            <ContentStack title="Group Chat" description="Enable groups of this type to participate in the chat system as chat channels.">
                <RadioButtonList v-model="isChatEnabledOverrideValue"
                                 label="Enable Group Chat"
                                 :items="triStateOverrideItems"
                                 :disabled="isSystem" />
            </ContentStack>

            <ContentStack title="Group Chat Settings" description="Control how group chat works for this group type.">
                <RadioButtonList v-model="isLeavingChatChannelAllowedOverrideValue"
                                 label="Allow Members to Leave Channel"
                                 :items="triStateOverrideItems"
                                 :disabled="isSystem" />

                <RadioButtonList v-model="isChatChannelPublicOverrideValue"
                                 label="Public Channel"
                                 :items="triStateOverrideItems"
                                 :disabled="isSystem" />

                <RadioButtonList v-model="isChatChannelAlwaysShownOverrideValue"
                                 label="Always Show Channel"
                                 :items="triStateOverrideItems"
                                 :disabled="isSystem" />

                <RadioButtonList v-model="chatPushNotificationModeOverrideValue"
                                 label="Push Notification Mode"
                                 :items="chatPushNotificationModeItems"
                                 :disabled="isSystem" />

                <ImageUploader v-model="chatChannelAvatarBinaryFile"
                               label="Channel Avatar"
                               :binaryFileTypeGuid="binaryFileTypeDefault"
                               :disabled="isSystem" />
            </ContentStack>
        </ContentSection>

        <!-- ========================== -->
        <!-- Section 9 - Group Sync Settings -->
        <!-- ========================== -->
        <GroupSync v-model:groupSyncs="groupSyncs"
                   :groupRoleOptions="groupTypeOptions.groupRoleOptions ?? []"
                   :systemCommunicationOptions="groupTypeOptions.systemCommunicationOptions ?? []"
                   :canAdministrate="canAdministrate"
                   :allowGroupSync="groupTypeOptions.allowGroupSync" />

        <!-- ========================== -->
        <!-- Section 10 - Group Member Workflows -->
        <!-- ========================== -->
        <GroupMemberWorkflows v-model:groupMemberWorkflowTriggers="groupMemberWorkflowTriggers"
                              :groupRoleOptions="groupTypeOptions.groupRoleOptions ?? []"
                              :allowSpecificGroupMemberWorkflows="groupTypeOptions.allowSpecificGroupMemberWorkflows" />
    </ContentSectionContainer>
</template>

<style scoped>
.static-compact :deep(.form-group.static-control .form-control-static) {
    padding: 0;
    min-height: 0;
}

.relationship-matrix > :nth-child(n+7) {
    margin-top: 0.75rem;
}
</style>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import { BinaryFiletype } from "@Obsidian/SystemGuids/binaryFiletype";
    import { DefinedType as DefinedTypeGuid } from "@Obsidian/SystemGuids/definedType";
    import { ScheduleType, ScheduleTypeDescription } from "@Obsidian/Enums/Group/scheduleType";
    import { RelationshipStrength, RelationshipStrengthDescription } from "@Obsidian/Enums/Group/relationshipStrength";
    import { ScheduleConfirmationLogic, ScheduleConfirmationLogicDescription } from "@Obsidian/Enums/Group/scheduleConfirmationLogic";
    import { ScheduleCoordinatorNotificationType, ScheduleCoordinatorNotificationTypeDescription } from "@Obsidian/Enums/Group/scheduleCoordinatorNotificationType";
    import { AttendanceRecordRequiredForCheckIn, AttendanceRecordRequiredForCheckInDescription } from "@Obsidian/Enums/Group/attendanceRecordRequiredForCheckIn";
    import { ElevatedSecurityLevel, ElevatedSecurityLevelDescription } from "@Obsidian/Enums/Security/elevatedSecurityLevel";
    import { ChatNotificationMode, ChatNotificationModeDescription } from "@Obsidian/Enums/Communication/Chat/chatNotificationMode";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import { TimePickerValue } from "@Obsidian/ViewModels/Controls/timePickerValue";
    import { GroupBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupBag";
    import { ParentGroupBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/parentGroupBag";
    import { GroupTypeOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupTypeOptionsBag";
    import { GroupMemberInheritedAttributeBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupMemberInheritedAttributeBag";
    import { GroupMemberWorkflowTriggerBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupMemberWorkflowTriggerBag";
    import { GroupRequirementBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupRequirementBag";
    import { GroupSyncBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupSyncBag";
    import { GroupLocationStateBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupLocationStateBag";
    import { PublicEditableAttributeBag } from "@Obsidian/ViewModels/Utility/publicEditableAttributeBag";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { setPropertiesBoxValue, useInvokeBlockAction, watchPropertyChanges } from "@Obsidian/Utility/block";
    import { propertyRef, updateRefValue } from "@Obsidian/Utility/component";

    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import ContentSectionContainer from "@Obsidian/Controls/contentSectionContainer.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import ConditionalWell from "@Obsidian/Controls/conditionalWell.obs";
    import AttributeValuesContainer from "@Obsidian/Controls/attributeValuesContainer.obs";
    import GroupMemberAttributes from "./groupMemberAttributes.partial.obs";
    import GroupRequirements from "./groupRequirements.partial.obs";
    import GroupSync from "./groupSync.partial.obs";
    import GroupMemberWorkflows from "./groupMemberWorkflows.partial.obs";
    import LocationsPanel from "./locationsPanel.partial.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import InlineCheckBox from "@Obsidian/Controls/inlineCheckBox.obs";
    import CheckBoxList from "@Obsidian/Controls/checkBoxList.obs";
    import InlineSwitch from "@Obsidian/Controls/inlineSwitch.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import RadioButtonList from "@Obsidian/Controls/radioButtonList.obs";
    import RockLabel from "@Obsidian/Controls/rockLabel.obs";
    import StaticFormControl from "@Obsidian/Controls/staticFormControl.obs";
    import GroupPicker from "@Obsidian/Controls/groupPicker.obs";
    import CampusPicker from "@Obsidian/Controls/campusPicker.obs";
    import PersonPicker from "@Obsidian/Controls/personPicker.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import DefinedValuePicker from "@Obsidian/Controls/definedValuePicker.obs";
    import ImageUploader from "@Obsidian/Controls/imageUploader.obs";
    import DayOfWeekPicker from "@Obsidian/Controls/dayOfWeekPicker.obs";
    import TimePicker from "@Obsidian/Controls/timePicker.obs";
    import ScheduleBuilder from "@Obsidian/Controls/scheduleBuilder.obs";
    import SchedulePicker from "@Obsidian/Controls/schedulePicker.obs";
    import { combineFlagValues, extractFlagValues, formatPercent, formatTimeValue, intToPercent, nullableInt, parseTimeString, percentToInt, scrollNotificationIntoView, stringToTriState, triStateToString } from "./utils.partial";
    import { enumToListItemBag } from "@Obsidian/Utility/enumUtils";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<ValidPropertiesBox<GroupBag>>,
            required: true
        },
        groupTypeOptions: {
            type: Object as PropType<GroupTypeOptionsBag>,
            required: true
        },
        allowedGroupTypes: {
            type: Array as PropType<ListItemBag[]>,
            default: () => [] as ListItemBag[]
        },
        signatureDocumentTemplates: {
            type: Array as PropType<ListItemBag[]>,
            default: () => [] as ListItemBag[]
        },
        preventSelectingInactiveCampus: {
            type: Boolean,
            default: false
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: ValidPropertiesBox<GroupBag>): void;
        (e: "propertyChanged", value: string): void;
    }>();

    // #region Constants

    const binaryFileTypeDefault = BinaryFiletype.Default;
    const recordSourceDefinedTypeGuid = DefinedTypeGuid.RecordSourceType;
    const scheduleTypeNone = ScheduleType.None;
    const scheduleTypeWeekly = ScheduleType.Weekly;
    const scheduleTypeCustom = ScheduleType.Custom;
    const scheduleTypeNamed = ScheduleType.Named;

    // #endregion

    // #region Values

    const invokeBlockAction = useInvokeBlockAction();

    const bag = computed((): GroupBag => props.modelValue?.bag ?? {} as GroupBag);

    const isAddMode = computed((): boolean => !bag.value.idKey);
    const isCurrentPersonGroupAdministrator = computed((): boolean => bag.value.isCurrentPersonGroupAdministrator === true);
    const isLimitedToSecurityRoleGroups = computed((): boolean => bag.value.isLimitedToSecurityRoleGroups === true);
    const hasChildGroups = computed((): boolean => bag.value.hasChildGroups === true);
    const isSystem = computed((): boolean => bag.value.isSystem === true);
    const canAdministrate = computed((): boolean => bag.value.canAdministrate === true);

    const showAdvancedRelationshipSettings = ref(
        (props.modelValue.bag?.leaderToLeaderRelationshipMultiplierOverride ?? null) !== null
        || (props.modelValue.bag?.leaderToNonLeaderRelationshipMultiplierOverride ?? null) !== null
        || (props.modelValue.bag?.nonLeaderToLeaderRelationshipMultiplierOverride ?? null) !== null
        || (props.modelValue.bag?.nonLeaderToNonLeaderRelationshipMultiplierOverride ?? null) !== null
    );

    const parentGroupIsActive = ref<boolean>(props.modelValue.bag?.parentGroup?.isActive ?? true);

    const allowedGroupTypeItems = ref<ListItemBag[]>(props.allowedGroupTypes ?? []);
    const groupTypeWarningElement = ref<InstanceType<typeof NotificationBox> | null>(null);

    const attributes = ref(props.modelValue.bag?.attributes ?? {});
    const attributeValues = ref(props.modelValue.bag?.attributeValues ?? {});
    const name = propertyRef(props.modelValue.bag?.name ?? "", "Name");
    const description = propertyRef(props.modelValue.bag?.description ?? "", "Description");
    const isActive = propertyRef(props.modelValue.bag?.isActive ?? true, "IsActive");
    const isPublic = propertyRef(props.modelValue.bag?.isPublic ?? false, "IsPublic");
    const inactiveReasonValueId = propertyRef<number | null>(props.modelValue.bag?.inactiveReasonValueId ?? null, "InactiveReasonValueId");
    const inactiveReasonNote = propertyRef(props.modelValue.bag?.inactiveReasonNote ?? "", "InactiveReasonNote");
    const inactivateChildGroups = propertyRef(props.modelValue.bag?.inactivateChildGroups ?? false, "InactivateChildGroups");
    const photoBinaryFile = propertyRef<ListItemBag | null>(props.modelValue.bag?.photoBinaryFile ?? null, "PhotoBinaryFile");
    const groupTypeId = propertyRef<number | null>(props.modelValue.bag?.groupTypeId ?? null, "GroupTypeId");
    const parentGroup = propertyRef<ListItemBag | null>(props.modelValue.bag?.parentGroup ?? null, "ParentGroup");
    const campus = propertyRef<ListItemBag | null>(props.modelValue.bag?.campus ?? null, "Campus");
    const statusValueId = propertyRef<number | null>(props.modelValue.bag?.statusValueId ?? null, "StatusValueId");
    const groupCapacity = propertyRef<number | null>(props.modelValue.bag?.groupCapacity ?? null, "GroupCapacity");
    const groupAdministrator = propertyRef<ListItemBag | undefined>(props.modelValue.bag?.administrator ?? undefined, "Administrator");
    const requiredSignatureDocumentTemplateId = propertyRef<number | null>(props.modelValue.bag?.requiredSignatureDocumentTemplateId ?? null, "RequiredSignatureDocumentTemplateId");
    const recordSourceValue = propertyRef<ListItemBag | null>(props.modelValue.bag?.groupMemberRecordSource ?? null, "GroupMemberRecordSource");
    const isSecurityRole = propertyRef(props.modelValue.bag?.isSecurityRole ?? false, "IsSecurityRole");
    const elevatedSecurityLevel = propertyRef<ElevatedSecurityLevel>(props.modelValue.bag?.elevatedSecurityLevel ?? ElevatedSecurityLevel.None, "ElevatedSecurityLevel");
    const overrideRelationshipStrength = propertyRef(props.modelValue.bag?.overrideRelationshipStrength ?? false, "OverrideRelationshipStrength");
    const relationshipStrengthOverride = propertyRef<RelationshipStrength>(props.modelValue.bag?.relationshipStrengthOverride ?? RelationshipStrength.None, "RelationshipStrengthOverride");
    const relationshipGrowthEnabledOverride = propertyRef<boolean>(props.modelValue.bag?.relationshipGrowthEnabledOverride ?? false, "RelationshipGrowthEnabledOverride");
    const leaderToLeaderRelationshipMultiplierOverride = propertyRef<number | null>(props.modelValue.bag?.leaderToLeaderRelationshipMultiplierOverride ?? null, "LeaderToLeaderRelationshipMultiplierOverride");
    const leaderToNonLeaderRelationshipMultiplierOverride = propertyRef<number | null>(props.modelValue.bag?.leaderToNonLeaderRelationshipMultiplierOverride ?? null, "LeaderToNonLeaderRelationshipMultiplierOverride");
    const nonLeaderToLeaderRelationshipMultiplierOverride = propertyRef<number | null>(props.modelValue.bag?.nonLeaderToLeaderRelationshipMultiplierOverride ?? null, "NonLeaderToLeaderRelationshipMultiplierOverride");
    const nonLeaderToNonLeaderRelationshipMultiplierOverride = propertyRef<number | null>(props.modelValue.bag?.nonLeaderToNonLeaderRelationshipMultiplierOverride ?? null, "NonLeaderToNonLeaderRelationshipMultiplierOverride");
    const rsvpReminderOffsetDays = propertyRef<number | null>(props.modelValue.bag?.rsvpReminderOffsetDays ?? null, "RsvpReminderOffsetDays");
    const rsvpReminderSystemCommunication = propertyRef<ListItemBag | null>(props.modelValue.bag?.rsvpReminderSystemCommunication ?? null, "RsvpReminderSystemCommunication");
    const scheduleType = propertyRef<ScheduleType>(props.modelValue.bag?.scheduleType ?? ScheduleType.None, "ScheduleType");
    const weeklyDayOfWeek = propertyRef<number | null>(props.modelValue.bag?.weeklyDayOfWeek ?? null, "WeeklyDayOfWeek");
    const weeklyTimeOfDay = propertyRef<string | null>(props.modelValue.bag?.weeklyTimeOfDay ?? null, "WeeklyTimeOfDay");
    const iCalendarContent = propertyRef(props.modelValue.bag?.iCalendarContent ?? "", "ICalendarContent");
    const namedSchedule = propertyRef<ListItemBag | null>(props.modelValue.bag?.namedSchedule ?? null, "NamedSchedule");
    const schedulingMustMeetRequirements = propertyRef(props.modelValue.bag?.schedulingMustMeetRequirements ?? false, "SchedulingMustMeetRequirements");
    const disableScheduling = propertyRef(props.modelValue.bag?.disableScheduling ?? false, "DisableScheduling");
    const disableScheduleToolboxAccess = propertyRef(props.modelValue.bag?.disableScheduleToolboxAccess ?? false, "DisableScheduleToolboxAccess");
    const scheduleConfirmationLogic = propertyRef<ScheduleConfirmationLogic | null>(props.modelValue.bag?.scheduleConfirmationLogic ?? null, "ScheduleConfirmationLogic");
    const scheduleCoordinatorPerson = propertyRef<ListItemBag | undefined>(props.modelValue.bag?.scheduleCoordinatorPerson ?? undefined, "ScheduleCoordinatorPerson");
    const hasCoordinatorNotificationOverride = propertyRef(props.modelValue.bag?.hasCoordinatorNotificationOverride ?? false, "HasCoordinatorNotificationOverride");
    const scheduleCoordinatorNotificationTypes = propertyRef<ScheduleCoordinatorNotificationType>(props.modelValue.bag?.scheduleCoordinatorNotificationTypes ?? ScheduleCoordinatorNotificationType.None, "ScheduleCoordinatorNotificationTypes");
    const attendanceRecordRequiredForCheckIn = propertyRef<AttendanceRecordRequiredForCheckIn>(props.modelValue.bag?.attendanceRecordRequiredForCheckIn ?? AttendanceRecordRequiredForCheckIn.ScheduleNotRequired, "AttendanceRecordRequiredForCheckIn");
    const isChatEnabledOverride = propertyRef<boolean | null>(props.modelValue.bag?.isChatEnabledOverride ?? null, "IsChatEnabledOverride");
    const isLeavingChatChannelAllowedOverride = propertyRef<boolean | null>(props.modelValue.bag?.isLeavingChatChannelAllowedOverride ?? null, "IsLeavingChatChannelAllowedOverride");
    const isChatChannelPublicOverride = propertyRef<boolean | null>(props.modelValue.bag?.isChatChannelPublicOverride ?? null, "IsChatChannelPublicOverride");
    const isChatChannelAlwaysShownOverride = propertyRef<boolean | null>(props.modelValue.bag?.isChatChannelAlwaysShownOverride ?? null, "IsChatChannelAlwaysShownOverride");
    const chatPushNotificationModeOverride = propertyRef<ChatNotificationMode | null>(props.modelValue.bag?.chatPushNotificationModeOverride ?? null, "ChatPushNotificationModeOverride");
    const chatChannelAvatarBinaryFile = propertyRef<ListItemBag | null>(props.modelValue.bag?.chatChannelAvatarBinaryFile ?? null, "ChatChannelAvatarBinaryFile");
    const groupMemberAttributes = propertyRef<PublicEditableAttributeBag[]>(props.modelValue.bag?.groupMemberAttributes ?? [], "GroupMemberAttributes");
    const groupRequirements = propertyRef<GroupRequirementBag[]>(props.modelValue.bag?.groupRequirements ?? [], "GroupRequirements");
    const groupSyncs = propertyRef<GroupSyncBag[]>(props.modelValue.bag?.groupSyncs ?? [], "GroupSyncs");
    const groupMemberWorkflowTriggers = propertyRef<GroupMemberWorkflowTriggerBag[]>(props.modelValue.bag?.groupMemberWorkflowTriggers ?? [], "GroupMemberWorkflowTriggers");
    const groupLocations = propertyRef<GroupLocationStateBag[]>(props.modelValue.bag?.groupLocations ?? [], "GroupLocations");
    const familyMemberLocationOptions = computed(() => props.modelValue.bag?.familyMemberLocationOptions ?? []);

    // The properties that are being edited. This should only contain
    // objects returned by propertyRef().
    const propRefs = [name, description, isActive, isPublic, inactiveReasonValueId, inactiveReasonNote, inactivateChildGroups, photoBinaryFile,
        groupTypeId, parentGroup, campus, statusValueId, groupCapacity, groupAdministrator, requiredSignatureDocumentTemplateId,
        recordSourceValue, isSecurityRole, elevatedSecurityLevel,
        overrideRelationshipStrength, relationshipStrengthOverride, relationshipGrowthEnabledOverride,
        leaderToLeaderRelationshipMultiplierOverride, leaderToNonLeaderRelationshipMultiplierOverride,
        nonLeaderToLeaderRelationshipMultiplierOverride, nonLeaderToNonLeaderRelationshipMultiplierOverride,
        rsvpReminderOffsetDays, rsvpReminderSystemCommunication, scheduleType, weeklyDayOfWeek, weeklyTimeOfDay, iCalendarContent, namedSchedule,
        schedulingMustMeetRequirements, disableScheduling, disableScheduleToolboxAccess,
        scheduleConfirmationLogic, scheduleCoordinatorPerson, hasCoordinatorNotificationOverride, scheduleCoordinatorNotificationTypes, attendanceRecordRequiredForCheckIn,
        isChatEnabledOverride, isLeavingChatChannelAllowedOverride, isChatChannelPublicOverride,
        isChatChannelAlwaysShownOverride, chatPushNotificationModeOverride, chatChannelAvatarBinaryFile,
        groupMemberAttributes, groupRequirements, groupSyncs, groupMemberWorkflowTriggers, groupLocations];

    // #endregion

    // #region Computed Values

    const isCapacityBelowMemberCount = computed((): boolean => {
        const capacity = groupCapacity.value;
        const memberCount = bag.value.memberCount ?? 0;
        return capacity !== null && capacity !== undefined && memberCount > 0 && capacity < memberCount;
    });

    const inactiveReasonValueIdValue = computed<string>({
        get(): string {
            return inactiveReasonValueId.value?.toString() ?? "";
        },
        set(newValue: string) {
            inactiveReasonValueId.value = nullableInt(newValue);
        }
    });

    const groupTypeIdValue = computed<string>({
        get(): string {
            return groupTypeId.value?.toString() ?? "";
        },
        set(newValue: string) {
            groupTypeId.value = nullableInt(newValue);
        }
    });

    const statusValueIdValue = computed<string>({
        get(): string {
            return statusValueId.value?.toString() ?? "";
        },
        set(newValue: string) {
            statusValueId.value = nullableInt(newValue);
        }
    });

    const requiredSignatureDocumentTemplateIdValue = computed<string>({
        get(): string {
            return requiredSignatureDocumentTemplateId.value?.toString() ?? "";
        },
        set(newValue: string) {
            requiredSignatureDocumentTemplateId.value = nullableInt(newValue);
        }
    });

    const elevatedSecurityLevelValue = computed<string>({
        get(): string {
            return elevatedSecurityLevel.value.toString();
        },
        set(newValue: string) {
            elevatedSecurityLevel.value = (parseInt(newValue, 10) || ElevatedSecurityLevel.None) as ElevatedSecurityLevel;
        }
    });

    const relationshipStrengthOverrideValue = computed<string>({
        get(): string {
            return relationshipStrengthOverride.value.toString();
        },
        set(newValue: string) {
            relationshipStrengthOverride.value = (nullableInt(newValue) ?? RelationshipStrength.None) as RelationshipStrength;
        }
    });

    const hasRelationshipStrengthOverride = computed((): boolean => {
        return relationshipStrengthOverride.value !== RelationshipStrength.None;
    });

    const rsvpReminderSystemCommunicationGuid = computed<string>({
        get(): string {
            return rsvpReminderSystemCommunication.value?.value ?? "";
        },
        set(newValue: string) {
            if (!newValue) {
                rsvpReminderSystemCommunication.value = null;
                return;
            }
            const item = (props.groupTypeOptions.rsvpSystemCommunicationOptions ?? []).find(i => (i.value ?? "") === newValue);
            rsvpReminderSystemCommunication.value = item
                ? { value: item.value ?? "", text: item.text ?? "" }
                : null;
        }
    });

    const leaderToLeaderRelationshipMultiplierOverrideValue = computed<number | null>({
        get(): number | null {
            return percentToInt(leaderToLeaderRelationshipMultiplierOverride.value);
        },
        set(newValue: number | null) {
            leaderToLeaderRelationshipMultiplierOverride.value = intToPercent(newValue);
        }
    });

    const leaderToNonLeaderRelationshipMultiplierOverrideValue = computed<number | null>({
        get(): number | null {
            return percentToInt(leaderToNonLeaderRelationshipMultiplierOverride.value);
        },
        set(newValue: number | null) {
            leaderToNonLeaderRelationshipMultiplierOverride.value = intToPercent(newValue);
        }
    });

    const nonLeaderToLeaderRelationshipMultiplierOverrideValue = computed<number | null>({
        get(): number | null {
            return percentToInt(nonLeaderToLeaderRelationshipMultiplierOverride.value);
        },
        set(newValue: number | null) {
            nonLeaderToLeaderRelationshipMultiplierOverride.value = intToPercent(newValue);
        }
    });

    const nonLeaderToNonLeaderRelationshipMultiplierOverrideValue = computed<number | null>({
        get(): number | null {
            return percentToInt(nonLeaderToNonLeaderRelationshipMultiplierOverride.value);
        },
        set(newValue: number | null) {
            nonLeaderToNonLeaderRelationshipMultiplierOverride.value = intToPercent(newValue);
        }
    });

    const scheduleTypeValue = computed<string>({
        get(): string {
            return scheduleType.value.toString();
        },
        set(newValue: string) {
            scheduleType.value = (parseInt(newValue, 10) || ScheduleType.None) as ScheduleType;
        }
    });

    const weeklyDayOfWeekValue = computed<string>({
        get(): string {
            return weeklyDayOfWeek.value != null ? weeklyDayOfWeek.value.toString() : "";
        },
        set(newValue: string) {
            weeklyDayOfWeek.value = nullableInt(newValue);
        }
    });

    const weeklyTimeOfDayValue = computed<TimePickerValue>({
        get(): TimePickerValue {
            return parseTimeString(weeklyTimeOfDay.value);
        },
        set(newValue: TimePickerValue) {
            weeklyTimeOfDay.value = formatTimeValue(newValue);
        }
    });

    const scheduleConfirmationLogicValue = computed<string>({
        get(): string {
            return scheduleConfirmationLogic.value?.toString() ?? "";
        },
        set(newValue: string) {
            scheduleConfirmationLogic.value = (newValue ? parseInt(newValue, 10) : null) as ScheduleConfirmationLogic | null;
        }
    });

    const scheduleCoordinatorNotificationTypesValue = computed<string[]>({
        get(): string[] {
            return extractFlagValues(scheduleCoordinatorNotificationTypes.value);
        },
        set(newValue: string[]) {
            scheduleCoordinatorNotificationTypes.value = combineFlagValues(newValue) as ScheduleCoordinatorNotificationType;
        }
    });

    const attendanceRecordRequiredForCheckInValue = computed<string>({
        get(): string {
            return attendanceRecordRequiredForCheckIn.value.toString();
        },
        set(newValue: string) {
            attendanceRecordRequiredForCheckIn.value = (parseInt(newValue, 10) || AttendanceRecordRequiredForCheckIn.ScheduleNotRequired) as AttendanceRecordRequiredForCheckIn;
        }
    });

    const isChatEnabledOverrideValue = computed<string>({
        get(): string {
            return triStateToString(isChatEnabledOverride.value);
        },
        set(newValue: string) {
            isChatEnabledOverride.value = stringToTriState(newValue);
        }
    });

    const isLeavingChatChannelAllowedOverrideValue = computed<string>({
        get(): string {
            return triStateToString(isLeavingChatChannelAllowedOverride.value);
        },
        set(newValue: string) {
            isLeavingChatChannelAllowedOverride.value = stringToTriState(newValue);
        }
    });

    const isChatChannelPublicOverrideValue = computed<string>({
        get(): string {
            return triStateToString(isChatChannelPublicOverride.value);
        },
        set(newValue: string) {
            isChatChannelPublicOverride.value = stringToTriState(newValue);
        }
    });

    const isChatChannelAlwaysShownOverrideValue = computed<string>({
        get(): string {
            return triStateToString(isChatChannelAlwaysShownOverride.value);
        },
        set(newValue: string) {
            isChatChannelAlwaysShownOverride.value = stringToTriState(newValue);
        }
    });

    const chatPushNotificationModeOverrideValue = computed<string>({
        get(): string {
            return chatPushNotificationModeOverride.value?.toString() ?? "";
        },
        set(newValue: string) {
            chatPushNotificationModeOverride.value = (newValue ? parseInt(newValue, 10) : null) as ChatNotificationMode | null;
        }
    });

    const isCurrentGroupTypeAllowed = computed((): boolean => {
        const currentId = groupTypeId.value;
        if (currentId === null || currentId === undefined) {
            return true;
        }
        return allowedGroupTypeItems.value.some(i => i.value === currentId.toString());
    });
    const signatureDocumentTemplateItems = computed((): ListItemBag[] => props.signatureDocumentTemplates ?? []);
    const inactiveReasonItems = computed((): ListItemBag[] => props.groupTypeOptions.inactiveReasons ?? []);
    const statusItems = computed((): ListItemBag[] => props.groupTypeOptions.statusValues ?? []);

    const elevatedSecurityLevelItems = computed((): ListItemBag[] => enumToListItemBag(ElevatedSecurityLevelDescription));

    const relationshipStrengthItems = computed((): ListItemBag[] => enumToListItemBag(RelationshipStrengthDescription));

    const scheduleTypeItems = computed((): ListItemBag[] => {
        const allowed = props.groupTypeOptions.allowedScheduleTypes ?? 0;
        const items: ListItemBag[] = [{ value: ScheduleType.None.toString(), text: ScheduleTypeDescription[ScheduleType.None] ?? "None" }];
        if ((allowed & ScheduleType.Weekly) === ScheduleType.Weekly) {
            items.push({ value: ScheduleType.Weekly.toString(), text: ScheduleTypeDescription[ScheduleType.Weekly] ?? "Weekly" });
        }
        if ((allowed & ScheduleType.Custom) === ScheduleType.Custom) {
            items.push({ value: ScheduleType.Custom.toString(), text: ScheduleTypeDescription[ScheduleType.Custom] ?? "Custom" });
        }
        if ((allowed & ScheduleType.Named) === ScheduleType.Named) {
            items.push({ value: ScheduleType.Named.toString(), text: ScheduleTypeDescription[ScheduleType.Named] ?? "Named" });
        }
        return items;
    });

    const scheduleConfirmationLogicItems = computed((): ListItemBag[] => enumToListItemBag(ScheduleConfirmationLogicDescription));

    const coordinatorNotificationItems = computed((): ListItemBag[] =>
        enumToListItemBag(ScheduleCoordinatorNotificationTypeDescription)
            .filter(i => i.value !== ScheduleCoordinatorNotificationType.None.toString())
    );

    const attendanceRecordRequiredForCheckInItems = computed((): ListItemBag[] => enumToListItemBag(AttendanceRecordRequiredForCheckInDescription));

    const triStateOverrideItems = computed((): ListItemBag[] => [
        { value: "", text: "Inherit from Group Type" },
        { value: "true", text: "Yes" },
        { value: "false", text: "No" }
    ]);

    const chatPushNotificationModeItems = computed((): ListItemBag[] => [
        { value: "", text: "Inherit from Group Type" },
        ...enumToListItemBag(ChatNotificationModeDescription)
    ]);

    const inheritedMemberAttributes = computed((): GroupMemberInheritedAttributeBag[] => {
        return props.groupTypeOptions?.inheritedMemberAttributes ?? [];
    });

    // #endregion

    // #region Watchers

    // Inbound: re-sync local refs when the parent rebags the entity.
    // updateRefValue no-ops when values are equal, so this terminates
    // any echo loop with the outbound watcher below.
    watch(() => props.modelValue, () => {
        updateRefValue(attributes, props.modelValue.bag?.attributes ?? {});
        updateRefValue(attributeValues, props.modelValue.bag?.attributeValues ?? {});
        updateRefValue(name, props.modelValue.bag?.name ?? "");
        updateRefValue(description, props.modelValue.bag?.description ?? "");
        updateRefValue(isActive, props.modelValue.bag?.isActive ?? true);
        updateRefValue(isPublic, props.modelValue.bag?.isPublic ?? false);
        updateRefValue(inactiveReasonValueId, props.modelValue.bag?.inactiveReasonValueId ?? null);
        updateRefValue(inactiveReasonNote, props.modelValue.bag?.inactiveReasonNote ?? "");
        updateRefValue(inactivateChildGroups, props.modelValue.bag?.inactivateChildGroups ?? false);
        updateRefValue(photoBinaryFile, props.modelValue.bag?.photoBinaryFile ?? null);

        // Section 2 Stack 1
        updateRefValue(groupTypeId, props.modelValue.bag?.groupTypeId ?? null);
        updateRefValue(parentGroup, props.modelValue.bag?.parentGroup ?? null);
        parentGroupIsActive.value = props.modelValue.bag?.parentGroup?.isActive ?? true;
        updateRefValue(campus, props.modelValue.bag?.campus ?? null);
        updateRefValue(statusValueId, props.modelValue.bag?.statusValueId ?? null);

        // Section 2 Stack 2
        updateRefValue(groupAdministrator, props.modelValue.bag?.administrator ?? undefined);
        updateRefValue(groupCapacity, props.modelValue.bag?.groupCapacity ?? null);
        updateRefValue(requiredSignatureDocumentTemplateId, props.modelValue.bag?.requiredSignatureDocumentTemplateId ?? null);
        updateRefValue(recordSourceValue, props.modelValue.bag?.groupMemberRecordSource ?? null);
        updateRefValue(isSecurityRole, props.modelValue.bag?.isSecurityRole ?? false);
        updateRefValue(elevatedSecurityLevel, props.modelValue.bag?.elevatedSecurityLevel ?? ElevatedSecurityLevel.None);

        // Section 2 Stack 3
        updateRefValue(overrideRelationshipStrength, props.modelValue.bag?.overrideRelationshipStrength ?? false);
        updateRefValue(relationshipStrengthOverride, props.modelValue.bag?.relationshipStrengthOverride ?? RelationshipStrength.None);
        updateRefValue(relationshipGrowthEnabledOverride, props.modelValue.bag?.relationshipGrowthEnabledOverride ?? false);
        updateRefValue(leaderToLeaderRelationshipMultiplierOverride, props.modelValue.bag?.leaderToLeaderRelationshipMultiplierOverride ?? null);
        updateRefValue(leaderToNonLeaderRelationshipMultiplierOverride, props.modelValue.bag?.leaderToNonLeaderRelationshipMultiplierOverride ?? null);
        updateRefValue(nonLeaderToLeaderRelationshipMultiplierOverride, props.modelValue.bag?.nonLeaderToLeaderRelationshipMultiplierOverride ?? null);
        updateRefValue(nonLeaderToNonLeaderRelationshipMultiplierOverride, props.modelValue.bag?.nonLeaderToNonLeaderRelationshipMultiplierOverride ?? null);

        // Section 3
        updateRefValue(rsvpReminderOffsetDays, props.modelValue.bag?.rsvpReminderOffsetDays ?? null);
        updateRefValue(rsvpReminderSystemCommunication, props.modelValue.bag?.rsvpReminderSystemCommunication ?? null);

        // Section 4 Stack 1
        updateRefValue(scheduleType, props.modelValue.bag?.scheduleType ?? ScheduleType.None);
        updateRefValue(weeklyDayOfWeek, props.modelValue.bag?.weeklyDayOfWeek ?? null);
        updateRefValue(weeklyTimeOfDay, props.modelValue.bag?.weeklyTimeOfDay ?? null);
        updateRefValue(iCalendarContent, props.modelValue.bag?.iCalendarContent ?? "");
        updateRefValue(namedSchedule, props.modelValue.bag?.namedSchedule ?? null);

        // Section 4 Stack 3
        updateRefValue(schedulingMustMeetRequirements, props.modelValue.bag?.schedulingMustMeetRequirements ?? false);
        updateRefValue(disableScheduling, props.modelValue.bag?.disableScheduling ?? false);
        updateRefValue(disableScheduleToolboxAccess, props.modelValue.bag?.disableScheduleToolboxAccess ?? false);
        updateRefValue(scheduleConfirmationLogic, props.modelValue.bag?.scheduleConfirmationLogic ?? null);
        updateRefValue(scheduleCoordinatorPerson, props.modelValue.bag?.scheduleCoordinatorPerson ?? undefined);
        updateRefValue(hasCoordinatorNotificationOverride, props.modelValue.bag?.hasCoordinatorNotificationOverride ?? false);
        updateRefValue(scheduleCoordinatorNotificationTypes, props.modelValue.bag?.scheduleCoordinatorNotificationTypes ?? ScheduleCoordinatorNotificationType.None);
        updateRefValue(attendanceRecordRequiredForCheckIn, props.modelValue.bag?.attendanceRecordRequiredForCheckIn ?? AttendanceRecordRequiredForCheckIn.ScheduleNotRequired);

        // Section 8
        updateRefValue(isChatEnabledOverride, props.modelValue.bag?.isChatEnabledOverride ?? null);
        updateRefValue(isLeavingChatChannelAllowedOverride, props.modelValue.bag?.isLeavingChatChannelAllowedOverride ?? null);
        updateRefValue(isChatChannelPublicOverride, props.modelValue.bag?.isChatChannelPublicOverride ?? null);
        updateRefValue(isChatChannelAlwaysShownOverride, props.modelValue.bag?.isChatChannelAlwaysShownOverride ?? null);
        updateRefValue(chatPushNotificationModeOverride, props.modelValue.bag?.chatPushNotificationModeOverride ?? null);
        updateRefValue(chatChannelAvatarBinaryFile, props.modelValue.bag?.chatChannelAvatarBinaryFile ?? null);

        // Section 5 + 6 — Attributes.
        updateRefValue(groupMemberAttributes, props.modelValue.bag?.groupMemberAttributes ?? []);

        // Section 7 / 9 / 10 — Phase 5 list payloads.
        updateRefValue(groupRequirements, props.modelValue.bag?.groupRequirements ?? []);
        updateRefValue(groupSyncs, props.modelValue.bag?.groupSyncs ?? []);
        updateRefValue(groupMemberWorkflowTriggers, props.modelValue.bag?.groupMemberWorkflowTriggers ?? []);

        // Section 4 Stack 2 — Phase 6 locations payload.
        updateRefValue(groupLocations, props.modelValue.bag?.groupLocations ?? []);
    });

    // Outbound: emit a fresh ValidPropertiesBox when any tracked
    // propertyRef changes.
    watch([attributeValues, ...propRefs], () => {
        const newValue: ValidPropertiesBox<GroupBag> = {
            bag: { ...props.modelValue.bag } as GroupBag
        };

        // Section 1
        setPropertiesBoxValue(newValue, "name", name.value);
        setPropertiesBoxValue(newValue, "description", description.value);
        setPropertiesBoxValue(newValue, "isActive", isActive.value);
        setPropertiesBoxValue(newValue, "isPublic", isPublic.value);
        setPropertiesBoxValue(newValue, "inactiveReasonValueId", inactiveReasonValueId.value);
        setPropertiesBoxValue(newValue, "inactiveReasonNote", inactiveReasonNote.value);
        setPropertiesBoxValue(newValue, "inactivateChildGroups", inactivateChildGroups.value);
        setPropertiesBoxValue(newValue, "photoBinaryFile", photoBinaryFile.value);

        // Section 2 Stack 1
        setPropertiesBoxValue(newValue, "groupTypeId", groupTypeId.value);
        setPropertiesBoxValue(newValue, "parentGroup", parentGroup.value as ParentGroupBag | null);
        setPropertiesBoxValue(newValue, "campus", campus.value);
        setPropertiesBoxValue(newValue, "statusValueId", statusValueId.value);

        // Section 2 Stack 2
        setPropertiesBoxValue(newValue, "administrator", groupAdministrator.value);
        setPropertiesBoxValue(newValue, "groupCapacity", groupCapacity.value);
        setPropertiesBoxValue(newValue, "requiredSignatureDocumentTemplateId", requiredSignatureDocumentTemplateId.value);
        setPropertiesBoxValue(newValue, "groupMemberRecordSource", recordSourceValue.value);
        setPropertiesBoxValue(newValue, "isSecurityRole", isSecurityRole.value);
        setPropertiesBoxValue(newValue, "elevatedSecurityLevel", elevatedSecurityLevel.value);

        // Section 2 Stack 3
        setPropertiesBoxValue(newValue, "overrideRelationshipStrength", overrideRelationshipStrength.value);
        setPropertiesBoxValue(newValue, "relationshipStrengthOverride", relationshipStrengthOverride.value);
        setPropertiesBoxValue(newValue, "relationshipGrowthEnabledOverride", relationshipGrowthEnabledOverride.value);
        setPropertiesBoxValue(newValue, "leaderToLeaderRelationshipMultiplierOverride", leaderToLeaderRelationshipMultiplierOverride.value);
        setPropertiesBoxValue(newValue, "leaderToNonLeaderRelationshipMultiplierOverride", leaderToNonLeaderRelationshipMultiplierOverride.value);
        setPropertiesBoxValue(newValue, "nonLeaderToLeaderRelationshipMultiplierOverride", nonLeaderToLeaderRelationshipMultiplierOverride.value);
        setPropertiesBoxValue(newValue, "nonLeaderToNonLeaderRelationshipMultiplierOverride", nonLeaderToNonLeaderRelationshipMultiplierOverride.value);

        // Section 3
        setPropertiesBoxValue(newValue, "rsvpReminderOffsetDays", rsvpReminderOffsetDays.value);
        setPropertiesBoxValue(newValue, "rsvpReminderSystemCommunication", rsvpReminderSystemCommunication.value);

        // Section 4 Stack 1
        setPropertiesBoxValue(newValue, "scheduleType", scheduleType.value);
        setPropertiesBoxValue(newValue, "weeklyDayOfWeek", weeklyDayOfWeek.value);
        setPropertiesBoxValue(newValue, "weeklyTimeOfDay", weeklyTimeOfDay.value);
        setPropertiesBoxValue(newValue, "iCalendarContent", iCalendarContent.value);
        setPropertiesBoxValue(newValue, "namedSchedule", namedSchedule.value);

        // Section 4 Stack 3
        setPropertiesBoxValue(newValue, "schedulingMustMeetRequirements", schedulingMustMeetRequirements.value);
        setPropertiesBoxValue(newValue, "disableScheduling", disableScheduling.value);
        setPropertiesBoxValue(newValue, "disableScheduleToolboxAccess", disableScheduleToolboxAccess.value);
        setPropertiesBoxValue(newValue, "scheduleConfirmationLogic", scheduleConfirmationLogic.value);
        setPropertiesBoxValue(newValue, "scheduleCoordinatorPerson", scheduleCoordinatorPerson.value);
        setPropertiesBoxValue(newValue, "hasCoordinatorNotificationOverride", hasCoordinatorNotificationOverride.value);
        setPropertiesBoxValue(newValue, "scheduleCoordinatorNotificationTypes", scheduleCoordinatorNotificationTypes.value);
        setPropertiesBoxValue(newValue, "attendanceRecordRequiredForCheckIn", attendanceRecordRequiredForCheckIn.value);

        // Section 8
        setPropertiesBoxValue(newValue, "isChatEnabledOverride", isChatEnabledOverride.value);
        setPropertiesBoxValue(newValue, "isLeavingChatChannelAllowedOverride", isLeavingChatChannelAllowedOverride.value);
        setPropertiesBoxValue(newValue, "isChatChannelPublicOverride", isChatChannelPublicOverride.value);
        setPropertiesBoxValue(newValue, "isChatChannelAlwaysShownOverride", isChatChannelAlwaysShownOverride.value);
        setPropertiesBoxValue(newValue, "chatPushNotificationModeOverride", chatPushNotificationModeOverride.value);
        setPropertiesBoxValue(newValue, "chatChannelAvatarBinaryFile", chatChannelAvatarBinaryFile.value);

        // Section 5 + 6 — Attributes.
        setPropertiesBoxValue(newValue, "attributeValues", attributeValues.value);
        setPropertiesBoxValue(newValue, "groupMemberAttributes", groupMemberAttributes.value);

        // Section 7 / 9 / 10 — Phase 5 list payloads.
        setPropertiesBoxValue(newValue, "groupRequirements", groupRequirements.value);
        setPropertiesBoxValue(newValue, "groupSyncs", groupSyncs.value);
        setPropertiesBoxValue(newValue, "groupMemberWorkflowTriggers", groupMemberWorkflowTriggers.value);

        // Section 4 Stack 2 — Phase 6 locations payload.
        setPropertiesBoxValue(newValue, "groupLocations", groupLocations.value);

        emit("update:modelValue", newValue);
    });

    /*
     * Refresh parentGroupIsActive whenever the picker emits a new
     * selection. GroupPicker only carries Value/Text, so we round-trip
     * to GetParentGroupInfo to learn the picked parent's active flag.
     * Works for both Edit-mode mid-session picks and Add-mode where the
     * initial bag has no parent at all. Clearing the picker hides the
     * banner without a server call. Failures default to active so a
     * transient error doesn't false-positive warn.
     */
    watch(() => parentGroup.value?.value, async (newKey) => {
        if (!newKey) {
            parentGroupIsActive.value = true;
            return;
        }

        const result = await invokeBlockAction<boolean>("GetParentGroupInfo", {
            parentGroupKey: newKey
        });

        parentGroupIsActive.value = result.isSuccess && typeof result.data === "boolean"
            ? result.data
            : true;
    });

    /*
     * Re-filter the Group Type dropdown whenever the parent picker
     * emits a new selection.
     */
    watch(() => parentGroup.value?.value, async (newKey) => {
        if (!isAddMode.value) {
            return;
        }

        const result = await invokeBlockAction<ListItemBag[]>("GetAllowedChildGroupTypes", {
            parentGroupKey: newKey ?? ""
        });

        if (result.isSuccess && Array.isArray(result.data)) {
            allowedGroupTypeItems.value = result.data;
        }
    });

    /*
     * Scroll the GroupType warning into view when the user's current
     * selection becomes invalid (typically after a parent-change
     * refilter). Without this, the banner may render below the fold
     * if the user is scrolled mid-form and the change-of-list happens
     * silently above their viewport.
     */
    watch(isCurrentGroupTypeAllowed, (allowed) => {
        if (allowed === false) {
            scrollNotificationIntoView(groupTypeWarningElement);
        }
    });

    // #endregion

    // Auto-emit propertyChanged for every tracked propertyRef.
    watchPropertyChanges(propRefs, emit);
</script>
