<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <component :is="rootTag"
               :href="modelValue.mapUrl || undefined"
               class="location-card rounded text-decoration-none">
        <div class="location-card-map-wrap">
            <div ref="mapContainer" class="location-card-map ratio-video w-100"></div>
            <span v-if="modelValue.mapUrl" class="location-card-expand" aria-hidden="true">
                <i class="ti ti-arrows-maximize"></i>
            </span>
        </div>
        <div v-if="hasBody" class="location-card-body">
            <div v-if="polygonLabel" class="font-italic text-interface-medium">{{ polygonLabel }}</div>
            <div v-if="modelValue.address" class="location-card-address">{{ modelValue.address }}</div>
            <div v-if="modelValue.scheduleText" class="mt-1 text-interface-medium">{{ modelValue.scheduleText }}</div>
        </div>
    </component>
</template>

<style scoped>
.location-card {
    display: block;
    color: inherit;
    border: 1px solid var(--color-interface-soft);
    overflow: hidden;
}

.location-card-map-wrap {
    position: relative;
}

.location-card + .location-card {
    margin-top: var(--spacing-small);
}

/*
    Setting pointer-events to none on the static-mode map ensures
    clicks bubble up to the wrapping anchor instead of being
    intercepted by Google Maps internal handlers (gestureHandling: "none"
    disables user gestures but does not stop event bubbling).
*/
.location-card-map {
    background: var(--color-interface-softer);
    pointer-events: none;
}

.location-card-expand {
    position: absolute;
    bottom: var(--spacing-xsmall);
    right: var(--spacing-xsmall);
    background: var(--color-interface-softest);
    padding: var(--spacing-xsmall);
    border-radius: var(--rounded-small);
    opacity: 0;
    transition: opacity 0.15s ease-in-out;
    pointer-events: none;
    line-height: 1;
    box-shadow: rgba(0, 0, 0, 0.2) 0 1px 4px -1px;
}

/*
    Per Q2.4, the hover overlay is desktop-only; touch devices skip
    the visual overlay and rely on the entire card being a navigable
    anchor (tap-anywhere navigates).
*/
@media (hover: hover) {
    .location-card:hover .location-card-expand {
        opacity: 1;
    }
}

.location-card-body {
    padding: var(--spacing-small) var(--spacing-medium);
}

.location-card-address {
    white-space: pre-line;
    color: var(--color-interface-strong);
}
</style>

<script setup lang="ts">
    /// <reference types="google.maps" />
    /* global google */
    import { computed, onBeforeMount, onMounted, onUnmounted, PropType, ref, watch } from "vue";
    import { Guid } from "@Obsidian/Types";
    import { Coordinate, DrawingMode } from "@Obsidian/Types/Controls/geo";
    import { GroupLocationPickerMode } from "@Obsidian/Enums/Group/groupLocationPickerMode";
    import { GroupMeetingLocationBag } from "@Obsidian/ViewModels/Blocks/Group/GroupDetail/groupMeetingLocationBag";
    import { GeoPickerGoogleMapSettingsBag } from "@Obsidian/ViewModels/Rest/Controls/geoPickerGoogleMapSettingsBag";
    import { loadMapResources, wellKnownToCoordinates } from "@Obsidian/Utility/geo";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<GroupMeetingLocationBag>,
            required: true
        },

        /**
         * The Guid of the Map Style DefinedValue from the block's
         * MapStyle attribute. Passed to loadMapResources so the rendered
         * map matches the site's configured style. Null falls back to
         * Rock's default map style on the server.
         */
        mapStyleValueGuid: {
            type: String as PropType<Guid | null>,
            required: false,
            default: null
        }
    });

    // #region Refs and computed

    const mapContainer = ref<HTMLDivElement | null>(null);
    const isGoogleLoaded = ref(false);
    const isMounted = ref(false);

    /**
     * Whether the card is wrapped in an anchor (when MapUrl is set) or
     * rendered as a div (when no GroupMapPage is configured). Wrapping
     * a non-navigable card in an anchor with no href would be confusing
     * for screen readers.
     */
    const rootTag = computed((): string => {
        return props.modelValue.mapUrl ? "a" : "div";
    });

    /**
     * Per Q2.5, mode drives the WKT parse path. Polygon goes through the
     * polygon parser; everything else uses the point parser.
     */
    const drawingMode = computed((): DrawingMode => {
        return props.modelValue.mode === GroupLocationPickerMode.Polygon ? "Polygon" : "Point";
    });

    /**
     * The "Geofenced Location" placeholder text rendered below the map
     * for polygon-style locations (which intentionally have no address
     * per the design). Returns null for other modes; the address /
     * schedule rows handle their own visibility via v-if.
     */
    const polygonLabel = computed((): string | null => {
        return props.modelValue.mode === GroupLocationPickerMode.Polygon
            ? "Geofenced Location"
            : null;
    });

    /**
     * Whether to render the body row at all. Hides the row when nothing
     * goes inside (no address, no schedule, not a polygon).
     */
    const hasBody = computed((): boolean => {
        return Boolean(polygonLabel.value)
            || Boolean(props.modelValue.address)
            || Boolean(props.modelValue.scheduleText);
    });

    // #endregion

    // #region Map initialization

    /**
     * Default Phoenix-area coordinates; matches what loadMapResources
     * returns when the configured map-style has no explicit center.
     * Used only when modelValue has no geometry to derive a center
     * from (e.g., an Address-mode location whose Location was never
     * geocoded).
     */
    const fallbackCenterLatitude = 33.590795;
    const fallbackCenterLongitude = -112.126459;

    let mapStyles: google.maps.MapTypeStyle[] = [];
    let mapId: string | null = null;
    let centerLatitude = fallbackCenterLatitude;
    let centerLongitude = fallbackCenterLongitude;
    let resizeObserver: ResizeObserver | null = null;

    onBeforeMount(async (): Promise<void> => {
        const settings = await loadMapResources({ mapStyleValueGuid: props.mapStyleValueGuid ?? "" });

        try {
            mapStyles = JSON.parse(settings.mapStyle ?? "");
        }
        catch {
            // Empty / malformed map style is non-fatal; the map renders
            // with the Google default styling.
        }

        // googleMapId lives on the broader GeoPickerGoogleMapSettingsBag
        // shape, not the trimmed GeoPickerSettingsBag that loadMapResources
        // returns by type. Mirrors the cast in geoPickerMap.obs.
        const googleSettings = settings as GeoPickerGoogleMapSettingsBag;
        mapId = googleSettings.googleMapId ?? null;
        centerLatitude = settings.centerLatitude ?? fallbackCenterLatitude;
        centerLongitude = settings.centerLongitude ?? fallbackCenterLongitude;

        isGoogleLoaded.value = true;
    });

    onMounted((): void => {
        isMounted.value = true;
        renderMap();
    });

    /*
        loadMapResources in onBeforeMount may resolve after onMounted
        runs, in which case the initial renderMap() call returned early
        because isGoogleLoaded was still false. The watcher re-fires
        renderMap once both flags settle so the map paints regardless
        of which side wins the race.
    */
    watch([isGoogleLoaded, isMounted], () => {
        if (isGoogleLoaded.value && isMounted.value) {
            renderMap();
        }
    });

    /**
     * Initializes the Google Map in static mode (no zoom / pan / icon
     * clicks per Q2.1) and overlays the marker or polygon shape. Called
     * after both the map resources are loaded and the component is
     * mounted; the watchers below short-circuit if either is not yet
     * ready.
     */
    function renderMap(): void {
        if (!isGoogleLoaded.value || !isMounted.value || !mapContainer.value) {
            return;
        }

        const coordinates = wellKnownToCoordinates(props.modelValue.mapData ?? "", drawingMode.value);
        const hasCoordinates = coordinates.length > 0;

        const center = hasCoordinates
            ? coordinatesToCenter(coordinates, drawingMode.value)
            : new google.maps.LatLng(centerLatitude, centerLongitude);

        const styledMap = new google.maps.StyledMapType(mapStyles, { name: "Styled Map" });

        const map = new google.maps.Map(mapContainer.value, {
            center,
            zoom: 16,
            disableDefaultUI: true,
            gestureHandling: "none",
            keyboardShortcuts: false,
            clickableIcons: false,
            mapTypeControlOptions: {
                mapTypeIds: [google.maps.MapTypeId.ROADMAP, "map_style"]
            },
            ...(mapId ? { mapId } : {})
        });

        map.mapTypes.set("map_style", styledMap);
        map.setMapTypeId("map_style");

        if (!hasCoordinates) {
            return;
        }

        let polygonBounds: google.maps.LatLngBounds | null = null;

        if (drawingMode.value === "Polygon") {
            const polygon = new google.maps.Polygon({
                paths: coordinates.map(([lat, lng]) => new google.maps.LatLng(lat, lng)),
                clickable: false,
                editable: false,
                strokeColor: "#0088cc",
                fillColor: "#0088cc",
                strokeWeight: 2,
                map
            });

            // Fit the viewport to the polygon's bounds so the whole
            // shape is visible inside the 16:9 frame.
            polygonBounds = new google.maps.LatLngBounds();
            polygon.getPath().forEach((latLng) => polygonBounds!.extend(latLng));
            map.fitBounds(polygonBounds);
        }
        else {
            new google.maps.Marker({
                position: new google.maps.LatLng(coordinates[0][0], coordinates[0][1]),
                map,
                clickable: false
            });
        }

        /*
            With aspect-ratio sizing, the container may have zero (or
            stale) dimensions when the map is constructed if the parent
            row hasn't fully laid out yet. Without this observer the
            tiles only fetch when the user scrolls the card into view
            and the browser re-resolves the layout. Forcing a resize
            event whenever the container's box changes keeps the map
            painted on initial load.
        */
        // Disconnect any prior observer in case renderMap re-runs (e.g.,
        // the watcher fires after both isGoogleLoaded and isMounted have
        // settled) so we don't stack observers on the same container.
        resizeObserver?.disconnect();
        resizeObserver = new ResizeObserver(() => {
            google.maps.event.trigger(map, "resize");

            // Re-frame the geometry so the polygon/marker stays
            // centered after the resize.
            if (polygonBounds) {
                map.fitBounds(polygonBounds);
            }
            else {
                map.setCenter(center);
            }
        });
        resizeObserver.observe(mapContainer.value);
    }

    onUnmounted((): void => {
        resizeObserver?.disconnect();
        resizeObserver = null;
    });

    /**
     * Returns a sensible center LatLng for the static map: the single
     * point for Point mode, or the polygon's bounding-box center for
     * Polygon mode. fitBounds runs after render for polygons; this
     * just primes the initial center so the map doesn't flash to a
     * default location before fitBounds settles.
     */
    function coordinatesToCenter(coordinates: Coordinate[], mode: DrawingMode): google.maps.LatLng {
        if (mode === "Point") {
            return new google.maps.LatLng(coordinates[0][0], coordinates[0][1]);
        }

        let minLat = coordinates[0][0];
        let maxLat = coordinates[0][0];
        let minLng = coordinates[0][1];
        let maxLng = coordinates[0][1];

        for (const [lat, lng] of coordinates) {
            if (lat < minLat) minLat = lat;
            if (lat > maxLat) maxLat = lat;
            if (lng < minLng) minLng = lng;
            if (lng > maxLng) maxLng = lng;
        }

        return new google.maps.LatLng((minLat + maxLat) / 2, (minLng + maxLng) / 2);
    }

    // #endregion
</script>
